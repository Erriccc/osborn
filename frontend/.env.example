# LiveKit Connection (the browser connects with NEXT_PUBLIC_LIVEKIT_URL)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Cloud machines only: forwarded to the agent machines this frontend provisions
# (platform-env.ts). Not read by the browser or /api/token; leave unset for local.
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API (for server-side token generation)
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Phone calls in (#361). Frontend host only; never forwarded to user machines.
# Shared number shown in Settings (E.164 or display form). When set, the
# LiveKit webhook only routes calls dialled to this number.
NEXT_PUBLIC_OSBORN_PHONE_NUMBER=
# Service role: the LiveKit webhook looks up the caller's verified number.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth "Send SMS" hook secret (v1,whsec_...), checked by /api/phone/verify-hook.
SUPABASE_SEND_SMS_HOOK_SECRET=
# Meta WhatsApp Cloud API: token, sending phone number id, approved authentication template.
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_AUTH_TEMPLATE=
META_WA_TEMPLATE_LANG=en_US
# Graph API version for the WhatsApp send; unset or malformed uses v23.0.
META_WA_GRAPH_VERSION=v23.0

# Follow-through (#378). Frontend host only; never forwarded to user machines.
# Comma-separated owner/repo=<user_id> entries: each repo receives follow-up issues
# from /api/follow-through (open items a voice session left behind) only when the
# posting machine's sync token belongs to that Supabase user id. Unset = no repo
# receives any. At most 30 items per account per rolling 24h (in memory, per server
# process). Filing uses GITHUB_TOKEN (the same token as the bug-report mirror).
# Example: FOLLOW_THROUGH_REPO_ALLOWLIST=owner/repo=00000000-0000-4000-8000-000000000000
FOLLOW_THROUGH_REPO_ALLOWLIST=
