# browser-apply candidate data. PLACEHOLDERS ONLY: never commit real values.
# Copy to ~/.osborn/candidate.env (fixed path), fill it in yourself, then: chmod 600 ~/.osborn/candidate.env
# The fill.mjs helper refuses the file if it is a symlink, not yours, or readable by group or other.
# It reads no environment variables; this file is its only input.
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PASSWORD=YOUR_ATS_ACCOUNT_PASSWORD
CANDIDATE_FIRST_NAME=YOUR_FIRST_NAME
CANDIDATE_LAST_NAME=YOUR_LAST_NAME
CANDIDATE_PHONE=YOUR_PHONE
CANDIDATE_ADDRESS_LINE1=YOUR_STREET_ADDRESS
CANDIDATE_CITY=YOUR_CITY
CANDIDATE_STATE=YOUR_STATE
CANDIDATE_ZIP=YOUR_ZIP

# Work history. The skill ships NO employment values: if a job is not here, the
# model must ask you instead of filling anything. Number the entries from 1 and
# add as many as you need (JOB_3, JOB_4, …); delete the ones you do not use.
CANDIDATE_JOB_1_TITLE=YOUR_JOB_TITLE
CANDIDATE_JOB_1_COMPANY=YOUR_EMPLOYER
CANDIDATE_JOB_1_START=YOUR_START_DATE
CANDIDATE_JOB_1_END=YOUR_END_DATE_OR_Present
CANDIDATE_JOB_1_DESCRIPTION=WHAT_YOU_DID

# Education, numbered the same way. Also ships empty on purpose.
CANDIDATE_EDUCATION_1_SCHOOL=YOUR_SCHOOL
CANDIDATE_EDUCATION_1_DEGREE=YOUR_DEGREE
CANDIDATE_EDUCATION_1_FIELD=YOUR_FIELD_OF_STUDY

# Optional: loopback CDP endpoint of the shared browser (non-loopback hosts are refused).
# CANDIDATE_CDP_URL=http://127.0.0.1:9222
