{
  "name": "osborn",
  "version": "0.9.82",
  "description": "Voice AI coding assistant - local agent that connects to Osborn frontend",
  "type": "module",
  "bin": {
    "osborn": "bin/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:logged": "tsx scripts/dev-logged.ts",
    "review": "tsx scripts/review.ts",
    "start": "tsx src/index.ts",
    "build": "tsc && rm -rf dist/prompts && cp -r src/prompts dist/prompts",
    "room": "tsx src/index.ts --room",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "voice",
    "ai",
    "coding",
    "assistant",
    "claude",
    "livekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erriccc/osborn.git"
  },
  "author": "Osborn Ojure",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.91",
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.0.0",
    "@livekit/agents": "1.4.6",
    "@livekit/agents-plugin-deepgram": "1.4.6",
    "@livekit/agents-plugin-elevenlabs": "1.4.6",
    "@livekit/agents-plugin-google": "1.4.6",
    "@livekit/agents-plugin-livekit": "1.4.6",
    "@livekit/agents-plugin-openai": "1.4.6",
    "@livekit/agents-plugin-silero": "1.4.6",
    "@livekit/rtc-node": "0.13.29",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.77.0",
    "@smithery/api": "^0.48.0",
    "@types/diff": "^8.0.0",
    "@vscode/ripgrep": "^1.17.1",
    "diff": "^8.0.4",
    "dotenv": "^16.4.0",
    "livekit-server-sdk": "^2.15.0",
    "minisearch": "^7.2.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.0.0",
    "ws": "^8.19.0",
    "yaml": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
