#!/bin/sh
# Refuse a push unless the steward signed off on the exact commit being pushed
# (and, on auto/* branches, a pre-PR review too). Git runs this for any tool or
# session, so it holds even where the repo's Claude hooks are not loaded. The
# markers are the same ones .claude/hooks/pre-pr-gate.py reads. Enabled by
# `git config core.hooksPath .githooks`.
zero=0000000000000000000000000000000000000000
gd=$(git rev-parse --absolute-git-dir) || exit 0
bad=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  if [ "$(cat "$gd/steward-reviewed" 2>/dev/null)" != "$lsha" ]; then
    echo "pre-push: refused $rref: no steward sign-off for $lsha. Run the steward on origin/main...HEAD; it records its CLEAN verdict in \"\$(git rev-parse --git-dir)/steward-reviewed\"." >&2
    bad=1
  fi
  case "$rref" in refs/heads/auto/*)
    if [ "$(cat "$gd/pre-pr-reviewed" 2>/dev/null)" != "$lsha" ]; then
      echo "pre-push: refused $rref: no pre-PR review for $lsha. Run the pre-pr-reviewer, fix its findings, then: git rev-parse HEAD > \"\$(git rev-parse --git-dir)/pre-pr-reviewed\"." >&2
      bad=1
    fi ;;
  esac
done
exit $bad
