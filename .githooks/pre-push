#!/bin/sh
# Refuse a branch push without the steward marker for the pushed commit (auto/*: and the pre-PR review marker). Enabled by core.hooksPath=.githooks.
zero=0000000000000000000000000000000000000000
gd=$(git rev-parse --absolute-git-dir) || exit 0
bad=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  if [ "$(cat "$gd/steward-reviewed" 2>/dev/null)" != "$lsha" ]; then
    echo "pre-push: refused $rref: no steward sign-off for $lsha. Run the steward on origin/main...$lsha; it records its CLEAN verdict in \"\$(git rev-parse --git-dir)/steward-reviewed\"." >&2
    bad=1
  fi
  case "$rref" in refs/heads/auto/*)
    if [ "$(cat "$gd/pre-pr-reviewed" 2>/dev/null)" != "$lsha" ]; then
      echo "pre-push: refused $rref: no pre-PR review for $lsha. Run the pre-pr-reviewer, fix its findings, then: echo $lsha > \"\$(git rev-parse --git-dir)/pre-pr-reviewed\". (A person can push with --no-verify.)" >&2
      bad=1
    fi ;;
  esac
done
exit $bad
